# Copy this file to .env and fill in real values. .env is git-ignored — it never gets committed.

# --- LiveKit connection (read by the livekit-agents framework itself) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM (Cerebras is the one actually wired in ai_clients.create_cerebras_llm) ---
CEREBRAS_API_KEY=
# SambaNova is an alternate LLM helper (ai_clients.create_sambanova_llm) — optional, only
# needed if you switch agent.py to call it instead of Cerebras.
SAMBANOVA_API_KEY=

# --- Local STT ---
# One of: whisper, vosk, faster_whisper
# faster_whisper is the only one that needs zero manual model download — see ONBOARDING.md.
LOCAL_STT_PROVIDER=faster_whisper
LOCAL_STT_LANGUAGE=hi
LOCAL_FASTER_WHISPER_MODEL=large-v3-turbo
LOCAL_FASTER_WHISPER_DEVICE=auto
LOCAL_FASTER_WHISPER_COMPUTE_TYPE=
LOCAL_FASTER_WHISPER_BEAM_SIZE=1

# --- Local TTS ---
# One of: piper, moonshine, edge, chatterbox
# chatterbox is the only one that needs zero manual model download — see ONBOARDING.md.
# piper/vosk/whisper all need model files that are NOT in this repo (see ONBOARDING.md).
LOCAL_TTS_PROVIDER=chatterbox
LOCAL_CHATTERBOX_LANGUAGE=hi
LOCAL_CHATTERBOX_DEVICE=auto
LOCAL_CHATTERBOX_VOICE_SAMPLE_PATH=

# --- Unused-but-installed API keys (livekit-plugins-deepgram/sarvam are dependencies but
# never imported anywhere in this codebase as of this writing — safe to leave blank) ---
# GROQ_API_KEY=
# DEEPGRAM_API_KEY=
# SARVAM_API_KEY=
